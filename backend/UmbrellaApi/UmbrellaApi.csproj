<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UmbrellaApi</RootNamespace>
    <AssemblyName>UmbrellaApi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      INTENTIONAL: Newtonsoft.Json is pinned to 12.0.3, which is below the patched
      threshold of 13.0.1 for CVE-2024-21907 (ReDoS via crafted regex input).
      Defender for DevOps / GitHub Dependabot will surface this as a high-severity
      finding in the "broken" baseline.  DO NOT upgrade in the broken branch.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
  </ItemGroup>

</Project>
