{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": []
  },
  "globalHeaders": {
    "Cache-Control": "no-store, no-cache"
  },
  "routes": [
    {
      "route": "/*",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      }
    }
  ]
}
